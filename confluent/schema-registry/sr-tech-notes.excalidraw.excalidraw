			"boundElements": [],
			"updated": 1773094919437,
			"link": null,
			"locked": false,
			"text": "DOCUMENT DATABASE: \n     enforces Schema on READ - Something like Dynamic Runtime Checking\nTraditional DATABASE\n      enforces SCHEMA on WRite ( fail fast validation from producers) - Something like Compile time checking",
			"rawText": "DOCUMENT DATABASE: \n     enforces Schema on READ - Something like Dynamic Runtime Checking\nTraditional DATABASE\n      enforces SCHEMA on WRite ( fail fast validation from producers) - Something like Compile time checking",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "DOCUMENT DATABASE: \n     enforces Schema on READ - Something like Dynamic Runtime Checking\nTraditional DATABASE\n      enforces SCHEMA on WRite ( fail fast validation from producers) - Something like Compile time checking",
			"autoResize": true,
			"lineHeight": 1.25
		},
