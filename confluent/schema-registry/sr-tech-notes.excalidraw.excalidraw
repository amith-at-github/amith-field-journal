		{
			"id": "g2B4y79v",
			"type": "text",
			"x": -2851.3121168645557,
			"y": 4121.805129496772,
			"width": 779.2593994140625,
			"height": 625,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
