			"link": null,
			"locked": false,
			"text": "\"subject naming strategy, TopicNameStrategy,\nAVRO union :  auto.register.schemas=false ; use.latest.version=true\nEach enable with a specific version and $red and OneOf\n{\n  \"oneOf\": [\n     { \"$ref\": \"Customer.schema.json\" },\n     { \"$ref\": \"Product.schema.json\" },\n     { \"$ref\": \"Order.schema.json }\n  ]\n}",
			"rawText": "\"subject naming strategy, TopicNameStrategy,\nAVRO union :  auto.register.schemas=false ; use.latest.version=true\nEach enable with a specific version and $red and OneOf\n{\n  \"oneOf\": [\n     { \"$ref\": \"Customer.schema.json\" },\n     { \"$ref\": \"Product.schema.json\" },\n     { \"$ref\": \"Order.schema.json }\n  ]\n}",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "\"subject naming strategy, TopicNameStrategy,\nAVRO union :  auto.register.schemas=false ; use.latest.version=true\nEach enable with a specific version and $red and OneOf\n{\n  \"oneOf\": [\n     { \"$ref\": \"Customer.schema.json\" },\n     { \"$ref\": \"Product.schema.json\" },\n     { \"$ref\": \"Order.schema.json }\n  ]\n}",
