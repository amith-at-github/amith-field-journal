		},
		{
			"id": "YkLut6ND",
			"type": "text",
			"x": -2858.252299961304,
			"y": 1655.6710666369108,
			"width": 705.1795043945312,
			"height": 25,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aG",
