		{
			"id": "jh83w6NS",
			"type": "text",
			"x": 6588.867420977343,
			"y": 578.3386213688367,
			"width": 542.3994750976562,
			"height": 140,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#a5d8ff",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bDV",
			"roundness": null,
			"seed": 1657571639,
			"version": 511,
			"versionNonce": 1707253015,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773091845010,
			"link": null,
			"locked": false,
			"text": "IMPORTANT:\n-  There is SCHEMA definition with a client.\n-  There is  Actual data encoded in Byte code.\n-   Schema Definition can be of Writer's Schema &\n    REaders schema.  In a RDBMS there is only oneschema\n-  Schema Definition has filed names, data tyep, optional required etc\n",
			"rawText": "IMPORTANT:\n-  There is SCHEMA definition with a client.\n-  There is  Actual data encoded in Byte code.\n-   Schema Definition can be of Writer's Schema &\n    REaders schema.  In a RDBMS there is only oneschema\n-  Schema Definition has filed names, data tyep, optional required etc\n",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "IMPORTANT:\n-  There is SCHEMA definition with a client.\n-  There is  Actual data encoded in Byte code.\n-   Schema Definition can be of Writer's Schema &\n    REaders schema.  In a RDBMS there is only oneschema\n-  Schema Definition has filed names, data tyep, optional required etc\n",
			"autoResize": true,
			"lineHeight": 1.25
		},
