			"link": null,
			"locked": false,
			"text": "Schema Registry rewrites schemas into a canonical form (ordering fields,\nreferences, metadata, etc.) before comparing or registering them, so formatting-\nonly differences don’t create new, “different” schemas",
			"rawText": "Schema Registry rewrites schemas into a canonical form (ordering fields, references, metadata, etc.) before comparing or registering them, so formatting-only differences don’t create new, “different” schemas",
