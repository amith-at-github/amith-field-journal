			"text": "{\n    \"userName\": \"Martin\",\n    \"favouriteNumber\": 1337,\n    \"interests\": [\"daydreaming\", \"hacking\"]\n}",
			"rawText": "{\n    \"userName\": \"Martin\",\n    \"favouriteNumber\": 1337,\n    \"interests\": [\"daydreaming\", \"hacking\"]\n}",
			"fontSize": 20,
			"fontFamily": 5,
