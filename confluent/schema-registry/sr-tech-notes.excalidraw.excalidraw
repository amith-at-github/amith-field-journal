			"lineHeight": 1.25
		},
		{
			"id": "paWzEXUw",
			"type": "text",
			"x": 6245.514809203106,
			"y": 3131.639594021301,
			"width": 780.4473876953125,
			"height": 140,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bEW",
			"roundness": null,
			"seed": 448830679,
			"version": 401,
			"versionNonce": 351007319,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773098040626,
			"link": null,
			"locked": false,
			"text": "Destination is typically in IMPORT mode\n  - SOURCE contet: READWRITE\n  - ONe exporter = ONE direction\n  - For bidirectional  two exporeter\n  - FOR DR, Act-Passive,  Passive is stet to import.\n  - Import is needed so that schema could be registered in  new context with different SCHEMA ID\n  - Use WildCard patterns like :*:. ( all subjects)",
			"rawText": "Destination is typically in IMPORT mode\n  - SOURCE contet: READWRITE\n  - ONe exporter = ONE direction\n  - For bidirectional  two exporeter\n  - FOR DR, Act-Passive,  Passive is stet to import.\n  - Import is needed so that schema could be registered in  new context with different SCHEMA ID\n  - Use WildCard patterns like :*:. ( all subjects)",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Destination is typically in IMPORT mode\n  - SOURCE contet: READWRITE\n  - ONe exporter = ONE direction\n  - For bidirectional  two exporeter\n  - FOR DR, Act-Passive,  Passive is stet to import.\n  - Import is needed so that schema could be registered in  new context with different SCHEMA ID\n  - Use WildCard patterns like :*:. ( all subjects)",
			"autoResize": true,
			"lineHeight": 1.25
		},
