			"isDeleted": false,
			"boundElements": [],
			"updated": 1773098040626,
			"link": null,
			"locked": false,
			"text": "Subjects can be qualified with a context:\n\nmysubject == :. :mysubject (default context).\n:.mycontext:mysubject targets mysubject in .mycontext. \n",
			"rawText": "Subjects can be qualified with a context:\n\nmysubject == :. :mysubject (default context).\n:.mycontext:mysubject targets mysubject in .mycontext. \n",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Subjects can be qualified with a context:\n\nmysubject == :. :mysubject (default context).\n:.mycontext:mysubject targets mysubject in .mycontext. \n",
