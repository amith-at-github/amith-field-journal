			"updated": 1772936232123,
			"link": null,
			"locked": false,
			"text": "\"subject naming strategy, TopicNameStrategy,\nUse import & OneOf\nEach enable with a specific version and reference in OneOf\nsyntax = \"proto3\";\n\npackage io.confluent.examples.proto;\n\nimport \"Customer.proto\";\nimport \"Product.proto\";\nimport \"Order.proto\";\n\nmessage AllTypes {\n    oneof oneof_type {\n        Customer customer = 1;\n        Product product = 2;\n        Order order = 3;\n    }\n}",
			"rawText": "\"subject naming strategy, TopicNameStrategy,\nUse import & OneOf\nEach enable with a specific version and reference in OneOf\nsyntax = \"proto3\";\n\npackage io.confluent.examples.proto;\n\nimport \"Customer.proto\";\nimport \"Product.proto\";\nimport \"Order.proto\";\n\nmessage AllTypes {\n    oneof oneof_type {\n        Customer customer = 1;\n        Product product = 2;\n        Order order = 3;\n    }\n}",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "\"subject naming strategy, TopicNameStrategy,\nUse import & OneOf\nEach enable with a specific version and reference in OneOf\nsyntax = \"proto3\";\n\npackage io.confluent.examples.proto;\n\nimport \"Customer.proto\";\nimport \"Product.proto\";\nimport \"Order.proto\";\n\nmessage AllTypes {\n    oneof oneof_type {\n        Customer customer = 1;\n        Product product = 2;\n        Order order = 3;\n    }\n}",
			"autoResize": true,
			"lineHeight": 1.25
		},
