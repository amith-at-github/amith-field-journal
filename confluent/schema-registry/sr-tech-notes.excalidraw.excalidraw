		{
			"id": "K7PjO8ZE",
			"type": "text",
			"x": -2899.877415903309,
			"y": 1241.0478673923353,
			"width": 1074.1793212890625,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aE",
			"roundness": null,
			"seed": 1099644780,
			"version": 143,
			"versionNonce": 1194103949,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772836147181,
			"link": null,
			"locked": false,
			"text": "Broker Schema ID Validation ( Confluent IP )\nThe feature is set at the topic level with 4 topic configs:\n\nconfluent.key.schema.validation (default is false, set to true to activate schema ID validation on the key)\nconfluent.value.schema.validation (default is false, set to true to activate schema ID validation on the value)\nconfluent.key.subject.name.strategy (default is TopicNameStrategy)\nconfluent.value.subject.name.strategy (default is TopicNameStrategy)",
			"rawText": "Broker Schema ID Validation ( Confluent IP )\nThe feature is set at the topic level with 4 topic configs:\n\nconfluent.key.schema.validation (default is false, set to true to activate schema ID validation on the key)\nconfluent.value.schema.validation (default is false, set to true to activate schema ID validation on the value)\nconfluent.key.subject.name.strategy (default is TopicNameStrategy)\nconfluent.value.subject.name.strategy (default is TopicNameStrategy)",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Broker Schema ID Validation ( Confluent IP )\nThe feature is set at the topic level with 4 topic configs:\n\nconfluent.key.schema.validation (default is false, set to true to activate schema ID validation on the key)\nconfluent.value.schema.validation (default is false, set to true to activate schema ID validation on the value)\nconfluent.key.subject.name.strategy (default is TopicNameStrategy)\nconfluent.value.subject.name.strategy (default is TopicNameStrategy)",
			"autoResize": true,
			"lineHeight": 1.25
		},
		{
