    {
      "seed": 234717496,
      "strokeStyle": "solid",
      "id": "SnDMPGJ0s3fJvoZ4_YzHA",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776724278515,
      "locked": false,
      "text": "Deleting Keys with log Compaction\nTombStone messages:\n   - delete key K by sending {k: null}\n   - Consumer has \n      log.clenaer.delete.retention.ms time to consume K before it\nis deleted (default 1 day)\n  ",
      "version": 1232,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "btf",
      "roundness": null,
      "containerId": "YL_ClfL1UrVuyhjAP-Wbp",
      "originalText": "Deleting Keys with log Compaction\nTombStone messages:\n   - delete key K by sending {k: null}\n   - Consumer has \n      log.clenaer.delete.retention.ms time to consume K before it is deleted (default 1 day)\n  ",
      "height": 175,
      "link": null,
      "strokeColor": "#1e1e1e",
