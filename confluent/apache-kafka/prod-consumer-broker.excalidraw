    {
      "isDeleted": false,
      "locked": false,
      "strokeColor": "#1e1e1e",
      "link": null,
      "roughness": 1,
      "groupIds": [],
      "index": "b9j",
      "backgroundColor": "#ffec99",
      "angle": 0,
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "version": 1376,
      "roundness": {
        "type": 3
      },
      "type": "rectangle",
      "updated": 1778283640683,
      "id": "Mm2A2g9w4WzB5Gln7ZRz-",
      "x": -4628.007617164469,
      "seed": 1344327819,
      "boundElements": [],
      "y": 603.7321748275613,
      "opacity": 100,
      "height": 142.57840496164548,
      "width": 815.5080695451975,
      "frameId": null,
      "strokeStyle": "solid",
      "versionNonce": 1430953784
    },
    {
      "seed": 1026620235,
      "strokeStyle": "solid",
      "id": "CWA9ESZehteKu1spV84vZ",
      "strokeWidth": 1,
      "roughness": 1,
      "isDeleted": false,
      "fontSize": 16,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1778283640683,
      "locked": false,
      "text": "In Apache Kafka, \"CRC\" refers to \"Cyclic Redundancy Check,\" a method used to detect data corruption\n by attaching a checksum to each message.\n This allows the system to verify whether a message has been altered \nduring transmission or storage by comparing the calculated checksum with the stored one; \nessentially ensuring data integrity within the Kafka cluster. ",
      "version": 1415,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "transparent",
      "index": "b9k",
      "roundness": null,
      "containerId": null,
      "originalText": "In Apache Kafka, \"CRC\" refers to \"Cyclic Redundancy Check,\" a method used to detect data corruption\n by attaching a checksum to each message.\n This allows the system to verify whether a message has been altered \nduring transmission or storage by comparing the calculated checksum with the stored one; \nessentially ensuring data integrity within the Kafka cluster. ",
      "height": 100,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "hachure",
      "groupIds": [],
      "versionNonce": 304216120,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -4623.37814830701,
      "angle": 0,
      "y": 624.7899084834353,
      "width": 804.111328125
    },
    {
      "seed": 860306661,
      "strokeStyle": "solid",
