    {
      "seed": 2116591432,
      "strokeStyle": "solid",
      "id": "IeToqCAwnYOwXVOFiXnXc",
      "strokeWidth": 2,
      "roughness": 1,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725437473,
      "locked": false,
      "text": "RHEL THP:\nIn Red Hat Enterprise Linux (RHEL), Transparent Huge Pages (THP) is a memory management feature that aims to improve system performance\n by using larger memory pages (2MB) instead of the default smaller pages (4KB). THP is enabled by default in RHEL and \nautomatically manages the allocation of these huge pages, unlike traditional Huge Pages which need to be reserved manually. \ndisabling THP in RHEL is recommended for Kafka broker deployments to prevent potential performance issues related to latency and memory management. \nThis step helps ensure that the deployment can handle high throughput and low latency, which are critical requirements for Kafka workloads.\n\nCheck THP:\nChecking THP status:\nYou can check the current THP status using the command: cat /sys/kernel/mm/transparent_hugepage/enabled. \n\nDisabling THP:\nIf you experience performance issues with THP, you can disable it using the same command, changing \nthe value to never. You can also disable it permanently by modifying bootloader configuration. \n\nKafka broker:\n \"socket.request.max.bytes\"=100MB and \"queued.max.request.bytes\"=-1\n\nThe default for socket.request.max.bytes is 104857600, which is more than enough for most environments.\n\nIn the event you do need to adjust this value you can do so with the followings steps:\n\nCheck your systems tcp buffer sizes with cat /proc/sys/net/ipv4/tcp_mem. The third value represents the maximum amount of memory the buffer may consume\nSet socket.request.max.bytes in each broker's server.properties file. Be careful not to exceed the maximum value found in the step above\nRestart each broker \n",
      "version": 575,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "transparent",
      "index": "bll",
      "roundness": null,
      "containerId": null,
      "originalText": "RHEL THP:\nIn Red Hat Enterprise Linux (RHEL), Transparent Huge Pages (THP) is a memory management feature that aims to improve system performance\n by using larger memory pages (2MB) instead of the default smaller pages (4KB). THP is enabled by default in RHEL and \nautomatically manages the allocation of these huge pages, unlike traditional Huge Pages which need to be reserved manually. \ndisabling THP in RHEL is recommended for Kafka broker deployments to prevent potential performance issues related to latency and memory management. \nThis step helps ensure that the deployment can handle high throughput and low latency, which are critical requirements for Kafka workloads.\n\nCheck THP:\nChecking THP status:\nYou can check the current THP status using the command: cat /sys/kernel/mm/transparent_hugepage/enabled. \n\nDisabling THP:\nIf you experience performance issues with THP, you can disable it using the same command, changing \nthe value to never. You can also disable it permanently by modifying bootloader configuration. \n\nKafka broker:\n \"socket.request.max.bytes\"=100MB and \"queued.max.request.bytes\"=-1\n\nThe default for socket.request.max.bytes is 104857600, which is more than enough for most environments.\n\nIn the event you do need to adjust this value you can do so with the followings steps:\n\nCheck your systems tcp buffer sizes with cat /proc/sys/net/ipv4/tcp_mem. The third value represents the maximum amount of memory the buffer may consume\nSet socket.request.max.bytes in each broker's server.properties file. Be careful not to exceed the maximum value found in the step above\nRestart each broker \n",
      "height": 650,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "groupIds": [
        "uYVjTkNHt_iAJcrmW3xSD"
      ],
      "versionNonce": 2101297224,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": 905.2948869146103,
      "angle": 0,
      "y": 3665.121747618743,
      "width": 1558.5390625
    },
    {
      "isDeleted": false,
      "locked": false,
      "strokeColor": "#1e1e1e",
      "link": null,
      "roughness": 1,
      "groupIds": [
        "ez_5E16X0kz-tWNXHSCh9"
      ],
      "index": "blm",
      "backgroundColor": "#ffec99",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "version": 756,
      "roundness": {
        "type": 3
      },
      "type": "rectangle",
      "updated": 1776725437473,
      "id": "zJbPXOOdU_4bHTLkwBPDh",
      "x": -230.8073039089586,
      "seed": 493188680,
      "boundElements": [],
      "y": 4419.977098770365,
      "opacity": 100,
      "height": 1140.169959259409,
      "width": 2722.1199637125073,
