      "x": -168.65497231188056,
      "seed": 1263256376,
      "boundElements": [
        {
          "type": "text",
          "id": "NZ3qwFbLqfVV-DN5ax67j"
        }
      ],
      "y": 2782.8657051381333,
      "opacity": 100,
      "height": 237.56387622172224,
      "width": 756.3141209814639,
      "frameId": null,
      "strokeStyle": "solid",
      "versionNonce": 1404077880
    },
    {
      "seed": 1951505208,
      "strokeStyle": "solid",
      "id": "NZ3qwFbLqfVV-DN5ax67j",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725857880,
      "locked": false,
      "text": "Tuning Virutual Memory Settings\n- Minimize memory swapping\n    vm.swappiness=1 (Default: 60)\n- Decrease the frequency of blocking flushes ( Synchronous)\n    vm.dirty_ratio=80 ( Default: 20)\n- Increase the frequency of non-blocking background flushes (asynchronous)\n    vm.dirty_background_ratio=5 ( Default: 10)\n- Set these parameters in /etc/sysctl.conf and load with sysctl -p",
      "version": 580,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "bttV",
      "roundness": null,
      "containerId": "fn3074iBPatjF1EMHtx1N",
      "originalText": "Tuning Virutual Memory Settings\n- Minimize memory swapping\n    vm.swappiness=1 (Default: 60)\n- Decrease the frequency of blocking flushes ( Synchronous)\n    vm.dirty_ratio=80 ( Default: 20)\n- Increase the frequency of non-blocking background flushes (asynchronous)\n    vm.dirty_background_ratio=5 ( Default: 10)\n- Set these parameters in /etc/sysctl.conf and load with sysctl -p",
      "height": 200,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "groupIds": [],
      "versionNonce": 462086200,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -163.65497231188056,
      "angle": 0,
      "y": 2787.8657051381333,
      "width": 742.639404296875
    },
