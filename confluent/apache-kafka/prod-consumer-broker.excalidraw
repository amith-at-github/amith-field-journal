      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725437474,
      "locked": false,
      "text": "Optimization per Service Agreement Broker level\n\nOptimize latency :   num.replica.fetchers=<value>\nOptimize throughput :  nothing to to \nOptimize durabliity:\n     default.replication.factor=3,  auto.create.topics.enable=false,  min.insync.replica=2 ,log.flush.interval.ms\n     unclean.leader.election.enable=false,   broker.rack=<rack ID>. log.flush.interval.message,\nOptimize Availbility:\n     unclean.leader.election.enable=true,   min.insync.replica=1,  num.recovery.threads.per.data.dir",
      "version": 1600,
      "autoResize": false,
      "type": "text",
