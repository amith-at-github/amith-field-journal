    },
    {
      "seed": 1347889992,
      "strokeStyle": "solid",
      "id": "OLtFAlFOPsW0Rl3qtdYqd",
      "strokeWidth": 2,
      "roughness": 1,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725437473,
      "locked": false,
      "text": "Explanation - This will allow you to use all of the brokers CPU cores for network\ntasks which can unblock it if IO is its bottleneck. Setting this to a value higher\nthan the number of CPU cores makes no sense and is wasteful.",
      "version": 585,
      "autoResize": false,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "bm5",
      "roundness": null,
      "containerId": null,
      "originalText": "Explanation - This will allow you to use all of the brokers CPU cores for network tasks which can unblock it if IO is its bottleneck. Setting this to a value higher than the number of CPU cores makes no sense and is wasteful.",
      "height": 75,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "groupIds": [
        "Xufv_bOU0joIzcTv4DzpR"
      ],
      "versionNonce": 28527688,
