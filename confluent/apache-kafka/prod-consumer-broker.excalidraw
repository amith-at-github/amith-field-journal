    {
      "seed": 909558088,
      "strokeStyle": "solid",
      "id": "QAQmSJNOLMSjn6UrIbljj",
      "strokeWidth": 2,
      "roughness": 1,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725437473,
      "locked": false,
      "text": "When to use - If you have brokers with a high number of CPU cores, particularly\nif you can see the IO average idle is low.",
      "version": 585,
      "autoResize": false,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "blz",
      "roundness": null,
      "containerId": null,
      "originalText": "When to use - If you have brokers with a high number of CPU cores, particularly if you can see the IO average idle is low.",
      "height": 50,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "groupIds": [
        "Xufv_bOU0joIzcTv4DzpR"
      ],
      "versionNonce": 91202120,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -19.781661618823364,
      "angle": 0,
      "y": 6484.3772184080535,
      "width": 785.8194580078125
    },
    {
      "seed": 861886536,
      "strokeStyle": "solid",
      "id": "VX4ILSfJSgZ9roJuNeVHd",
      "strokeWidth": 2,
      "roughness": 1,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725437473,
      "locked": false,
      "text": "How to set - You can set this to the same value as the number of CPU cores",
      "version": 585,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "bm0",
      "roundness": null,
      "containerId": null,
      "originalText": "How to set - You can set this to the same value as the number of CPU cores",
      "height": 25,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "groupIds": [
        "Xufv_bOU0joIzcTv4DzpR"
      ],
      "versionNonce": 1255414088,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -19.781661618823364,
      "angle": 0,
      "y": 6591.8772184080535,
      "width": 758.3595581054688
    },
    {
      "seed": 1297944392,
      "strokeStyle": "solid",
      "id": "J3XDWWQTtGA7RwYBglqWi",
      "strokeWidth": 2,
      "roughness": 1,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725437473,
      "locked": false,
      "text": "Explanation / Details - This will allow you to use all of the brokers CPU cores\nfor IO tasks which can unblock it if IO is its bottleneck. Setting this to a value\nhigher than the number of CPU cores makes no sense and is wasteful.",
      "version": 585,
      "autoResize": false,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "bm1",
      "roundness": null,
      "containerId": null,
