    {
      "seed": 1648276536,
      "strokeStyle": "solid",
      "id": "Q2xuBMevQp2GIP5d8ww4J",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 15.598820203369677,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776727343642,
      "locked": false,
      "text": "Controlling the Number of messages Returned.\n- poll(Duration) fetches from multiple partition across multiple\nbrokers.\n- max.partition.fech.bytes(default: 1 MB )  :  Max amount of\ndata fetched per partitions\n- max.poll.records ( default: 500 ) : Alternatively manage total\nsize .",
      "version": 929,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "buq",
      "roundness": null,
      "containerId": "gyHfGpfVr50MFxsKypBCB",
      "originalText": "Controlling the Number of messages Returned.\n- poll(Duration) fetches from multiple partition across multiple brokers.\n- max.partition.fech.bytes(default: 1 MB )  :  Max amount of data fetched per partitions\n- max.poll.records ( default: 500 ) : Alternatively manage total size .",
      "height": 136.48967677948468,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
