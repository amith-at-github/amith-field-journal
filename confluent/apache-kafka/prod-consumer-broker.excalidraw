    },
    {
      "seed": 270528926,
      "strokeStyle": "solid",
      "id": "g3YHSaTcZG9tX8SvBHhAe",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 28,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725418333,
      "locked": false,
      "text": "config Parameters:\n",
      "version": 962,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffffff",
      "index": "bHf",
      "roundness": null,
      "containerId": null,
      "originalText": "config Parameters:\n",
      "height": 70,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "hachure",
      "groupIds": [],
      "versionNonce": 2060890168,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -6006.831514345541,
      "angle": 0,
      "y": -906.3800238085644,
      "width": 252.4759063720703
    },
    {
      "seed": 11275742,
      "strokeStyle": "solid",
      "id": "xmfTtrkgK86FT4vo0faT6",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 28,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725418333,
      "locked": false,
      "text": "\npartitioner.class: \n     Default functionality: (if None specified or null).\n          if key exists:  compute hash (key) , modulo (num_partitions) # Hashing algo varies by client\n          if NoKey exists: use Sticky Partition strategy. #evenly distribute data across partitions\n     Custom partitioner is supported. user has to implement a partitioner\npartitioner.ignore.keys: bool\n           # if true: keys are ignored for partition (if user has keys but if data has to be uniformly distributed)\npartitioner.adaptive.partitioning.enable : bool\npartitioner.availability.timeout.ms:\n           # If your goal is to optimize sending data to brokers using the Sticky Partitioning Strategy, \nthese two configurations helps. When partitioner.adaptive.partitioning.enable=true, \nthe producer will look at how fast the current set of brokers are responding to requests to store data \nand adapt to send more data to the faster brokers. \n          # In conjunction, we have partitioner.availability.timeout.ms, \nwhich says that if a request to a partition takes longer than this timeout, \nthen that partition will be ignored, and data will be sent elsewhere.",
      "version": 1754,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffffff",
      "index": "bHg",
      "roundness": null,
      "containerId": null,
      "originalText": "\npartitioner.class: \n     Default functionality: (if None specified or null).\n          if key exists:  compute hash (key) , modulo (num_partitions) # Hashing algo varies by client\n          if NoKey exists: use Sticky Partition strategy. #evenly distribute data across partitions\n     Custom partitioner is supported. user has to implement a partitioner\npartitioner.ignore.keys: bool\n           # if true: keys are ignored for partition (if user has keys but if data has to be uniformly distributed)\npartitioner.adaptive.partitioning.enable : bool\npartitioner.availability.timeout.ms:\n           # If your goal is to optimize sending data to brokers using the Sticky Partitioning Strategy, \nthese two configurations helps. When partitioner.adaptive.partitioning.enable=true, \nthe producer will look at how fast the current set of brokers are responding to requests to store data \nand adapt to send more data to the faster brokers. \n          # In conjunction, we have partitioner.availability.timeout.ms, \nwhich says that if a request to a partition takes longer than this timeout, \nthen that partition will be ignored, and data will be sent elsewhere.",
      "height": 595,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "hachure",
      "groupIds": [],
      "versionNonce": 772008248,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -5935.154620888613,
      "angle": 0,
      "y": -878.3756415416224,
      "width": 1525.55126953125
    },
    {
      "seed": 1740682334,
      "strokeStyle": "solid",
      "id": "YFzNUf8jTdlaPHkSLu1Tq",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 28,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725418333,
      "locked": false,
      "text": "org.apache.kafka.clients.producer.RoundRobinPartitioner: This partitioning strategy is that each record\n in a series of consecutive records will be sent to a different partition(no matter if the ‘key’ is provided or not), \nuntil we run out of partitions and start over again.\n Note: There’s a known issue that will cause uneven distribution when new batch is created. \nPlease check KAFKA-9965 for more detail",
      "version": 607,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffffff",
      "index": "bHj",
      "roundness": null,
      "containerId": null,
      "originalText": "org.apache.kafka.clients.producer.RoundRobinPartitioner: This partitioning strategy is that each record\n in a series of consecutive records will be sent to a different partition(no matter if the ‘key’ is provided or not), \nuntil we run out of partitions and start over again.\n Note: There’s a known issue that will cause uneven distribution when new batch is created. \nPlease check KAFKA-9965 for more detail",
      "height": 175,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "hachure",
      "groupIds": [],
      "versionNonce": 1495401016,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -7664.289055737933,
      "angle": 0,
      "y": -491.3523776189111,
      "width": 1564.19091796875
    },
    {
      "seed": 1461983966,
      "strokeStyle": "solid",
      "id": "QSOYitm1qdhC0hTJrxGsq",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 28,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725418333,
      "locked": false,
      "text": "stickyPartitioner: \n     #Record Assignment: When a producer sends records to a Kafka topic without specified keys, \nthe sticky partitioner assigns all such records to a single partition\n for a defined duration or until the batch is filled(or linger.ms). This approach helps to create larger batches of records.\n     #Switching Partitions: Once a batch is fully formed or other conditions (like the linger.ms timeout) are met, \nthe sticky partitioner can switch to another partition, maintaining a balance over time\n by eventually spreading records evenly across all partitions.\n\n\n",
      "version": 686,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffffff",
      "index": "bHk",
      "roundness": null,
      "containerId": null,
      "originalText": "stickyPartitioner: \n     #Record Assignment: When a producer sends records to a Kafka topic without specified keys, \nthe sticky partitioner assigns all such records to a single partition\n for a defined duration or until the batch is filled(or linger.ms). This approach helps to create larger batches of records.\n     #Switching Partitions: Once a batch is fully formed or other conditions (like the linger.ms timeout) are met, \nthe sticky partitioner can switch to another partition, maintaining a balance over time\n by eventually spreading records evenly across all partitions.\n\n\n",
      "height": 350,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "hachure",
      "groupIds": [],
      "versionNonce": 185924408,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -7656.506152513712,
      "angle": 0,
      "y": -806.4928090759506,
      "width": 1652.138916015625
    },
