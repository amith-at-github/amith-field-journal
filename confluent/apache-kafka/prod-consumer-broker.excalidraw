    },
    {
      "seed": 1071460920,
      "strokeStyle": "solid",
      "id": "LRV2GwPkFo0kL-yM-TQ3K",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725844839,
      "locked": false,
      "text": "Capacity Planning :  Number of Brokers\n\n- Storage\n   Number of brokers = ( messages per day * message size * Retention days\n        * Replication )/ ( disk space per broker)\n- Network Bandwidth\n    Number of Brokers = ( messages per sec * message size * number of\nconsumers) / ( Network bandwidth per Broker )\n\n- Maximums : 4000 partition per Broker , 50 NOdes, 200000 Partitions per\ncluster for Zookeeper,  for KRaft , 4000 partitions per broker, 2M\npartitions per cluster",
      "version": 1149,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "btw",
      "roundness": null,
      "containerId": "dDIctrK8nP9ejcdK4-Ttz",
      "originalText": "Capacity Planning :  Number of Brokers\n\n- Storage\n   Number of brokers = ( messages per day * message size * Retention days\n        * Replication )/ ( disk space per broker)\n- Network Bandwidth\n    Number of Brokers = ( messages per sec * message size * number of consumers) / ( Network bandwidth per Broker )\n\n- Maximums : 4000 partition per Broker , 50 NOdes, 200000 Partitions per cluster for Zookeeper,  for KRaft , 4000 partitions per broker, 2M partitions per cluster",
      "height": 300,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "groupIds": [],
      "versionNonce": 449660728,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": 759.4407579108702,
      "angle": 0,
      "y": -763.5353989697733,
      "width": 741.7394409179688
