    {
      "seed": 1647584840,
      "strokeStyle": "solid",
      "id": "TF29iFpqGatIJm3bPeOKk",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 16,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776725437474,
      "locked": false,
      "text": "Broker Important Files\n  Folder :  /var/lib/kafka\n  File :\n    recovery-point-offset-checkpoint :   Last offset flushed to disk\n    cleaner-offset-checkpoint : offset up to which the cleaner has cleaned(compacted topics\nonly)\n    replication -offset-checkpoint:   Last committed offset (HWM id of messge)\n    log-start-offset-checkpoint:  Internal broker log where kafka tracks which messages (\nfrom to offset) were successfully checkpointed to disk.\n    leader-epoch-checkpoint : Per partion. Contains rows with epoch and offset, Each row is\na checkpoint for the latest recorder leader epoch and the leader's latest offset upon\nbecoming leader",
      "version": 1532,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "bnx",
      "roundness": null,
      "containerId": "7xJwAQZ72hpag1Xr44kmg",
      "originalText": "Broker Important Files\n  Folder :  /var/lib/kafka\n  File :\n    recovery-point-offset-checkpoint :   Last offset flushed to disk\n    cleaner-offset-checkpoint : offset up to which the cleaner has cleaned(compacted topics  only)\n    replication -offset-checkpoint:   Last committed offset (HWM id of messge)\n    log-start-offset-checkpoint:  Internal broker log where kafka tracks which messages ( from to offset) were successfully checkpointed to disk.\n    leader-epoch-checkpoint : Per partion. Contains rows with epoch and offset, Each row is a checkpoint for the latest recorder leader epoch and the leader's latest offset upon becoming leader",
      "height": 240,
      "link": null,
      "strokeColor": "#1e1e1e",
