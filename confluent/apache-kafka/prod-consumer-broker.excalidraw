      "versionNonce": 1850992440
    },
    {
      "seed": 1202874440,
      "strokeStyle": "solid",
      "id": "h46aMn2l2RNxUsM_vuQD2",
      "strokeWidth": 1,
      "roughness": 0,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1776726533496,
      "locked": false,
      "text": "Consume Committed Transactions\n- isolation.level =read_committed:  \n- Consumer API alsone cannot guarantee exactly once processing\n- Use Kafka Streams or \"consume-process-produce\" pattern to\nguarantee exactly once procesing.\n    Set enable.auto.commit=false in consumer\n    Use sendOffsetsToTransaction() in Producer",
      "version": 506,
      "autoResize": true,
      "type": "text",
      "backgroundColor": "#ffec99",
      "index": "bty",
      "roundness": null,
      "containerId": "jWkhOsTaVqVVuC_4l5Kf3",
      "originalText": "Consume Committed Transactions\n- isolation.level =read_committed:  \n- Consumer API alsone cannot guarantee exactly once processing\n- Use Kafka Streams or \"consume-process-produce\" pattern to guarantee exactly once procesing.\n    Set enable.auto.commit=false in consumer\n    Use sendOffsetsToTransaction() in Producer",
      "height": 175,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "groupIds": [
        "BfpWGZZoegHkI4frAW2_O"
