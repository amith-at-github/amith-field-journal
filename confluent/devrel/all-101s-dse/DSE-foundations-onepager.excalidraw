      "versionNonce": 183000108,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781660485608,
      "link": null,
      "locked": false,
      "text": "producer.send(record, (metadata, exception) -> {\n    executor.submit(() -> {\n        if (exception == null)\n            save_metadata(metadata)\n        else\n            handle_error(exception)  // In executor thread\n    })\n})",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "producer.send(record, (metadata, exception) -> {\n    executor.submit(() -> {\n        if (exception == null)\n            save_metadata(metadata)\n        else\n            handle_error(exception)  // In executor thread\n    })\n})",
      "autoResize": true,
      "lineHeight": 1.25
    },
