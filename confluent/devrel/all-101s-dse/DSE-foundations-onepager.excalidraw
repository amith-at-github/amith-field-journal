      "type": "text",
      "x": 9383.385300076105,
      "y": 4205.1025996294775,
      "width": 445.6956787109375,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
