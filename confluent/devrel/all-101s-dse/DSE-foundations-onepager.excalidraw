      "isDeleted": false,
      "boundElements": [],
      "updated": 1794869016397,
      "link": null,
      "locked": false,
      "text": "1 Region --> 1..* AZz\n1 AZ ---> 1..* Datacenter \n1 Datacenter ---> 1..* Racks | 0..* Kafka Cluster\n1 Rack --->  0..* Kafka cluster | 0..* kafka broker\n\n1 Kafka cluster ---> 1..* kafka broker\n1 kafka broker ---> 1..* kafka topics\n1 kafka topic --->  1..* kafka partitions\n1 kafka partiton ---> 1..* segment files\n1 segment files --->  1..* kafka record",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 Region --> 1..* AZz\n1 AZ ---> 1..* Datacenter \n1 Datacenter ---> 1..* Racks | 0..* Kafka Cluster\n1 Rack --->  0..* Kafka cluster | 0..* kafka broker\n\n1 Kafka cluster ---> 1..* kafka broker\n1 kafka broker ---> 1..* kafka topics\n1 kafka topic --->  1..* kafka partitions\n1 kafka partiton ---> 1..* segment files\n1 segment files --->  1..* kafka record",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
