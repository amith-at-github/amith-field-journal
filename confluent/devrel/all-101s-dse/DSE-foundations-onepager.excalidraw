      "isDeleted": false,
      "boundElements": [],
      "updated": 1794869016400,
      "locked": false,
      "text": "while (true) {\n    process(record)\n    consumer.commitAsync()  // Fast loop\n}\n\nfinally {\n    consumer.commitSync()   // Safe shutdown\n    consumer.close()\n}\n// Fast + Safe = PRODUCTION READY",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "iLqcU5tn-liM-NWV9dYMA",
      "originalText": "while (true) {\n    process(record)\n    consumer.commitAsync()  // Fast loop\n}\n\nfinally {\n    consumer.commitSync()   // Safe shutdown\n    consumer.close()\n}\n// Fast + Safe = PRODUCTION READY",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
