    {
      "id": "mI9W4jt-AqmCRz5Z3Z43Q",
      "type": "text",
      "x": 2644.2389069314086,
      "y": 861.8108309307263,
      "width": 476.0797119140625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTa",
      "roundness": null,
      "seed": 558309932,
      "version": 775,
      "versionNonce": 907715092,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781632177247,
      "link": null,
      "locked": false,
      "text": "\nIncremental Aggregation\n\nIncremental aggregation is computing aggregate\nresults one event at a time, updating state with\neach new event, rather than loading all data and\ncomputing once.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ivzWGmDAb1nAe-0Isy-1z",
      "originalText": "\nIncremental Aggregation\n\nIncremental aggregation is computing aggregate results one event at a time, updating state with each new event, rather than loading all data and computing once.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Sy04CLlbaEqf2imyl5t-E",
      "type": "rectangle",
