      "isDeleted": false,
      "boundElements": null,
      "updated": 1781660475422,
      "link": null,
      "locked": false,
      "text": "try:\n    metadata = producer.send(record).get()\ncatch KafkaException e:\n    handle(e)  // Caught immediately\ncatch DatabaseException e:\n    handle(e)  // Can rollback transaction",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "try:\n    metadata = producer.send(record).get()\ncatch KafkaException e:\n    handle(e)  // Caught immediately\ncatch DatabaseException e:\n    handle(e)  // Can rollback transaction",
      "autoResize": true,
      "lineHeight": 1.25
    },
