      "seed": 644712236,
      "version": 667,
      "versionNonce": 1864280620,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781632173166,
      "link": null,
      "locked": false,
      "text": "Offline ( BATCH) Aggreation\nCharacteristics:\n✓ Knows all data in advance\n✓ Can optimize based on full dataset\n✓ Higher latency (wait for full batch)\n✓ Single pass possible",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Sy04CLlbaEqf2imyl5t-E",
      "originalText": "Offline ( BATCH) Aggreation\nCharacteristics:\n✓ Knows all data in advance\n✓ Can optimize based on full dataset\n✓ Higher latency (wait for full batch)\n✓ Single pass possible",
      "autoResize": true,
      "lineHeight": 1.25
    },
