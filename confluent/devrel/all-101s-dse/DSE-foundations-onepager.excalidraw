    {
      "id": "tMu69rE3PV5oYuJfolEgf",
      "type": "text",
      "x": 9780.984610558813,
      "y": 1132.4798977780151,
      "width": 476.0797119140625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c02W",
      "roundness": null,
      "seed": 476504509,
      "version": 793,
      "versionNonce": 91874291,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794869016391,
      "link": null,
      "locked": false,
      "text": "\nIncremental Aggregation\n\nIncremental aggregation is computing aggregate\nresults one event at a time, updating state with\neach new event, rather than loading all data and\ncomputing once.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e49IcuU4f0DVyFqvgusgU",
      "originalText": "\nIncremental Aggregation\n\nIncremental aggregation is computing aggregate\nresults one event at a time, updating state with\neach new event, rather than loading all data and\ncomputing once.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
