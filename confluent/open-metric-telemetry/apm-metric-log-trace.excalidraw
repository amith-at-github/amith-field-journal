      "link": null,
      "locked": false,
      "text": "A query is built from \n- Selectors: http_requests_total{status=\"200\"}\n- Functions: abs, rate.\n- Aggregations: sum by (status)\n- OPerators:  > , + ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A query is built from \n- Selectors: http_requests_total{status=\"200\"}\n- Functions: abs, rate.\n- Aggregations: sum by (status)\n- OPerators:  > , + ",
      "autoResize": true,
      "lineHeight": 1.25
