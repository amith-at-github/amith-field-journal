      "text": "- Service that runs alongside\napplication. Captures JMX Mbeans and\ntransforms to prometheus text\nformat",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "niuR_mrOo4TPXa6QaBbCn",
      "originalText": "- Service that runs alongside application. Captures JMX Mbeans and transforms to prometheus text format",
