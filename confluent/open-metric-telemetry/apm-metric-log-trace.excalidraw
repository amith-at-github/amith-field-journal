      "isDeleted": false,
      "boundElements": [],
      "updated": 1778281606704,
      "link": null,
      "locked": false,
      "text": "Pattern summary: component logs -> ship directly with agents; \nPlatform audit logs -> Kafka-native then sink; \nCloud audit logs -> replicate/export first, then sink to Splunk or Elasticsearch. \nUse separate streams/indexes for cp-operational, cp-audit, and ccloud-audit.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pattern summary: component logs -> ship directly with agents; \nPlatform audit logs -> Kafka-native then sink; \nCloud audit logs -> replicate/export first, then sink to Splunk or Elasticsearch. \nUse separate streams/indexes for cp-operational, cp-audit, and ccloud-audit.",
      "lineHeight": 1.25,
      "index": "b4G",
      "autoResize": true
    },
