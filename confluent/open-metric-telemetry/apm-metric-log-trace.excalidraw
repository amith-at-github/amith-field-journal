      "isDeleted": false,
      "boundElements": [],
      "updated": 1778281544828,
      "link": null,
      "locked": false,
      "text": "Micrometer\nMicrometer acts like \"SLF4J for metrics\"—it provides a\nvendor-neutral interface to instrument your code once\nand then export that data to any monitoring system\n(Prometheus, Datadog, etc.) without changing your\nlogic.\nHas support for Springboot",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "96wk-BCjPK2vxQBmEuGMC",
      "originalText": "Micrometer\nMicrometer acts like \"SLF4J for metrics\"—it provides a vendor-neutral interface to instrument your code once and then export that data to any monitoring system (Prometheus, Datadog, etc.) without changing your logic.\nHas support for Springboot",
      "autoResize": true,
      "lineHeight": 1.25
    },
