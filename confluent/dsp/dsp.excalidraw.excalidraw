    },
    {
      "id": "439kv5MY",
      "type": "text",
      "x": 1737.6768708476752,
      "y": -1901.034567349422,
      "width": 1231.518388118709,
      "height": 407.1630192131829,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2B",
      "roundness": null,
      "seed": 1148663848,
      "version": 764,
      "versionNonce": 714645288,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773245089238,
      "link": null,
      "locked": false,
      "text": "=============================================================================================\nFEATURE           ||| SHARED DATABASE (OLD) | EVENT SOURCING      | DATA MESH\n=============================================================================================\nCoupling             |||   High (Schema-bound)        | Low (Contract-based).  | Low (Domain-owned)\n---------------------------------------------------------------------------------------------------------------------------\nScalability          |||  Difficult (Vertical)          | High (Distributed)        | Highest (Federated)\n\n---------------------------------------------------------------------------------------------------------------------------\nData Consistency  |||   Immediate (ACID)          | Eventual                   | Analytical/Eventual\n\n---------------------------------------------------------------------------------------------------------------------------\nPrimary Goal        |||  Data Integration           | State Transition         | Data as a Product\n\n---------------------------------------------------------------------------------------------------------------------------\nCommon Tools      |||  Oracle, SQL Server          | Kafka, EventStoreDB    | Trino, Snowflake, Confluent Cloud enabler for Data\nmesh)\n=============================================================================================",
      "fontSize": 19.160612668855666,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=============================================================================================\nFEATURE           ||| SHARED DATABASE (OLD) | EVENT SOURCING      | DATA MESH\n=============================================================================================\nCoupling             |||   High (Schema-bound)        | Low (Contract-based).  | Low (Domain-owned)\n---------------------------------------------------------------------------------------------------------------------------\nScalability          |||  Difficult (Vertical)          | High (Distributed)        | Highest (Federated)\n\n---------------------------------------------------------------------------------------------------------------------------\nData Consistency  |||   Immediate (ACID)          | Eventual                   | Analytical/Eventual\n\n---------------------------------------------------------------------------------------------------------------------------\nPrimary Goal        |||  Data Integration           | State Transition         | Data as a Product\n\n---------------------------------------------------------------------------------------------------------------------------\nCommon Tools      |||  Oracle, SQL Server          | Kafka, EventStoreDB    | Trino, Snowflake, Confluent Cloud enabler for Data mesh)\n=============================================================================================",
      "autoResize": false,
      "lineHeight": 1.25
    },
