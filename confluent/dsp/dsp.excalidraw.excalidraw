    },
    {
      "id": "LeJTf5Qn",
      "type": "text",
      "x": -2068.051036259075,
      "y": 2406.673116815657,
      "width": 1671.3239005008256,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5A",
      "roundness": null,
      "seed": 1311891752,
      "version": 376,
      "versionNonce": 1731963486,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781457443348,
      "link": null,
      "locked": false,
      "text": "=========================================================================================\nSTRATEGY          | DATA SHIPPING (OLD)      | DATA LOCALITY (HADOOP)   | DATA-FLOW (STREAM)\n=========================================================================================\nThe Flow          | Data moves to Code.      | Code moves to Data.      | Data flows thru Code.\n-----------------------------------------------------------------------------------------\nPrimary Resource  | Network Bandwidth.       | Local Disk I/O.          | In-Memory State/RAM.\n-----------------------------------------------------------------------------------------\nExecution Type    | Request-Response.        | Scheduled Batch Jobs.    | Continuous/Forever.\n-----------------------------------------------------------------------------------------\nData State        | Transient in RAM.        | Persistent on Disk.      | Stateful in Memory.\n-----------------------------------------------------------------------------------------\nLatency Goal      | Human Speed (Secs).      | Process Speed (Hours).   | Event Speed (ms).\n-----------------------------------------------------------------------------------------\nScaling Trigger   | User requests.           | Data Volume growth.      | Event Velocity.\n=========================================================================================",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=========================================================================================\nSTRATEGY          | DATA SHIPPING (OLD)      | DATA LOCALITY (HADOOP)   | DATA-FLOW (STREAM)\n=========================================================================================\nThe Flow          | Data moves to Code.      | Code moves to Data.      | Data flows thru Code.\n-----------------------------------------------------------------------------------------\nPrimary Resource  | Network Bandwidth.       | Local Disk I/O.          | In-Memory State/RAM.\n-----------------------------------------------------------------------------------------\nExecution Type    | Request-Response.        | Scheduled Batch Jobs.    | Continuous/Forever.\n-----------------------------------------------------------------------------------------\nData State        | Transient in RAM.        | Persistent on Disk.      | Stateful in Memory.\n-----------------------------------------------------------------------------------------\nLatency Goal      | Human Speed (Secs).      | Process Speed (Hours).   | Event Speed (ms).\n-----------------------------------------------------------------------------------------\nScaling Trigger   | User requests.           | Data Volume growth.      | Event Velocity.\n=========================================================================================",
      "autoResize": false,
      "lineHeight": 1.25
    },
