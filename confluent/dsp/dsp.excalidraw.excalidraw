      "text": "PATTERN: Event-Driven Architecture / Kappa Architecture.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PATTERN: Event-Driven Architecture / Kappa Architecture.",
