    {
      "id": "LWXniqaXEnut-FNo2Hgz_",
      "type": "text",
      "x": 2568.684779593353,
      "y": 1585.7823984906918,
      "width": 470.7196044921875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
