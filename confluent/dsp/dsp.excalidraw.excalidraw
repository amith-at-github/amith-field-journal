    {
      "id": "fsNDxS8_cRPcwaed1SJsy",
      "type": "text",
      "x": 3321.3837182360785,
      "y": 1441.022255565354,
      "width": 500.25970458984375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
