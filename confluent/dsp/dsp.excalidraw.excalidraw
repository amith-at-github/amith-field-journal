    {
      "id": "KPk1asdu",
      "type": "text",
      "x": -1252.4720127222915,
      "y": -158.8897270017776,
      "width": 599.8954467773438,
      "height": 191.7457110012294,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2l",
