      "boundElements": [],
      "updated": 1773245089238,
      "link": null,
      "locked": false,
      "text": "TECHNOLOGY EVOLUTION ( EIP to Streaming)",
      "fontSize": 20.90364484287648,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TECHNOLOGY EVOLUTION ( EIP to Streaming)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pxzVUCbw",
      "type": "text",
      "x": 3009.52029600233,
      "y": -724.4518210193291,
      "width": 1035.7403564453125,
      "height": 365.8137847503384,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2N",
      "roundness": null,
      "seed": 1091488344,
      "version": 241,
      "versionNonce": 1837114152,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773245089238,
      "link": null,
      "locked": false,
      "text": "DEPLOYMENT TOPOLOGY\n=========================================================================================\nFEATURE           | HADOOP TOPOLOGY (BATCH)          | STREAMING TOPOLOGY (REAL-TIME)\n=========================================================================================\nExecution Type    | Job-based (Start -> End)         | Topology-based (Runs forever)\n-----------------------------------------------------------------------------------------\nMaster Node       | NameNode/JobTracker (Monolithic) | Nimbus/JobManager (Stateless/HA)\n-----------------------------------------------------------------------------------------\nStorage Layer     | HDFS (Files on local disks)      | Kafka/Pulsar (Distributed Logs)\n-----------------------------------------------------------------------------------------\nScalability       | Add physical nodes to cluster    | Elastic containers (K8s/Serverless)\n-----------------------------------------------------------------------------------------\nFailure Recovery  | Re-run the entire batch job      | Checkpointing (Resume from offset)\n=========================================================================================",
      "fontSize": 20.90364484287648,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DEPLOYMENT TOPOLOGY\n=========================================================================================\nFEATURE           | HADOOP TOPOLOGY (BATCH)          | STREAMING TOPOLOGY (REAL-TIME)\n=========================================================================================\nExecution Type    | Job-based (Start -> End)         | Topology-based (Runs forever)\n-----------------------------------------------------------------------------------------\nMaster Node       | NameNode/JobTracker (Monolithic) | Nimbus/JobManager (Stateless/HA)\n-----------------------------------------------------------------------------------------\nStorage Layer     | HDFS (Files on local disks)      | Kafka/Pulsar (Distributed Logs)\n-----------------------------------------------------------------------------------------\nScalability       | Add physical nodes to cluster    | Elastic containers (K8s/Serverless)\n-----------------------------------------------------------------------------------------\nFailure Recovery  | Re-run the entire batch job      | Checkpointing (Resume from offset)\n=========================================================================================",
      "autoResize": true,
      "lineHeight": 1.25
    },
