    {
      "id": "v2iU9XIsQYeyuiWlx8Qh_",
      "type": "text",
      "x": 2567.6464142459963,
      "y": 1398.077315777141,
      "width": 476.0797119140625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7m",
      "roundness": null,
      "seed": 1998311134,
      "version": 209,
      "versionNonce": 603036190,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781461848848,
      "link": null,
      "locked": false,
      "text": "\nIncremental Aggregation\n\nIncremental aggregation is computing aggregate\nresults one event at a time, updating state with\neach new event, rather than loading all data and\ncomputing once.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Ue8Yw1ik4OuMbgichXxlk",
      "originalText": "\nIncremental Aggregation\n\nIncremental aggregation is computing aggregate results one event at a time, updating state with each new event, rather than loading all data and computing once.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "haVM9P-fL5mDeFrMGQkom",
      "type": "rectangle",
