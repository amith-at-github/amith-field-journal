    },
    {
      "id": "Bi9G8QG6wLP3-KXmLKRsR",
      "type": "text",
      "x": 4039.5431342338497,
      "y": 1864.6602402750623,
      "width": 1021.4812621540219,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8o",
      "roundness": null,
      "seed": 802302338,
      "version": 605,
      "versionNonce": 48704898,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781464280737,
      "link": null,
      "locked": false,
      "text": "Operation       Set             Operation       Identity    Associative Commutative Idempotent  Type\nSUM             Numbers         +                      0              Y            Y             N           Monoid\nCOUNT           Integers        +                    0               Y           Y           N           Monoid\nMAX             Ordered vals    max                  -∞             Y           Y           Y           Monoid\nMIN             Ordered vals    min                    +∞            Y           Y           Y           Monoid\nPRODUCT         Numbers         ×                   1              Y           Y           N           Monoid\nAVG             Numbers         (sum,count)        (0,0)           Y           Y           N           Monoid\nCONCAT          Strings         concat              \"\"             Y           N           N           Monoid\nSET UNION       Sets            ∪                    ∅             Y           Y           Y           Monoid\nBITWISE AND     Integers        &               all 1s           Y           Y           N           Monoid\nBITWISE OR      Integers        |                   0            Y           Y           Y           Monoid\nMEDIAN                                                 none          N           Y           N           Non-Monoid\nVARIANCE                                                -         complex        Y           N          Non- Monoid",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Operation       Set             Operation       Identity    Associative Commutative Idempotent  Type\nSUM             Numbers         +                      0              Y            Y             N           Monoid\nCOUNT           Integers        +                    0               Y           Y           N           Monoid\nMAX             Ordered vals    max                  -∞             Y           Y           Y           Monoid\nMIN             Ordered vals    min                    +∞            Y           Y           Y           Monoid\nPRODUCT         Numbers         ×                   1              Y           Y           N           Monoid\nAVG             Numbers         (sum,count)        (0,0)           Y           Y           N           Monoid\nCONCAT          Strings         concat              \"\"             Y           N           N           Monoid\nSET UNION       Sets            ∪                    ∅             Y           Y           Y           Monoid\nBITWISE AND     Integers        &               all 1s           Y           Y           N           Monoid\nBITWISE OR      Integers        |                   0            Y           Y           Y           Monoid\nMEDIAN                                                 none          N           Y           N           Non-Monoid\nVARIANCE                                                -         complex        Y           N          Non- Monoid",
      "autoResize": false,
      "lineHeight": 1.25
    },
