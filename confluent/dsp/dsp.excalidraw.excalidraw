      "link": null,
      "locked": false,
      "text": "Operation that work\nincreementally\nSUM, COUNT, MAX, MIN, AVG,\nSET UNION, STRING CONCAT\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "CuIgdTyYIS7a1O_PTrhUT",
      "originalText": "Operation that work increementally\nSUM, COUNT, MAX, MIN, AVG, SET UNION, STRING CONCAT\n",
      "autoResize": true,
